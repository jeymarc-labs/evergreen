---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/motion.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getSite } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  /** Share image (LinkedIn, iMessage, …). Cropped to 1200×630. */
  image?: ImageMetadata | null;
  imageAlt?: string | null;
  type?: 'website' | 'article';
}

const {
  title = 'Jeymarc Sison',
  description = 'Jeymarc Sison: running, travel, tech and learning AI in public.',
  image,
  imageAlt,
  type = 'website',
} = Astro.props;

const { showSamplePill } = await getSite();
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = image
  ? new URL((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Jeymarc Sison · Blog" href="/rss.xml" />
    <meta property="og:site_name" content="Jeymarc Sison" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {
      shareImage && (
        <>
          <meta property="og:image" content={shareImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
        </>
      )
    }
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f7a4f" />
    <title>{title}</title>
    <script is:inline>
      // Set the theme before paint. Stored "light" or "dark" wins; anything else (or blocked
      // storage, e.g. some private modes) follows the system setting.
      (() => {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        const dark =
          saved === 'dark' || (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        // Motion may hide things until the motion script reveals them. If that script hasn't
        // started within 3 s (failed to load, blocked, old browser), show everything in place.
        const root = document.documentElement;
        root.classList.add('js');
        setTimeout(() => {
          if (!window.__motion) root.classList.remove('js');
        }, 3000);
      })();
    </script>
  </head>
  <body class="bg-surface text-ink font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {
      showSamplePill && (
        <p class="fixed bottom-4 left-1/2 z-50 -translate-x-1/2 rounded-full bg-ink px-4 py-1.5 text-xs font-medium text-surface shadow-lg">
          Preview · sample content
        </p>
      )
    }
    <script>
      // Motion helper: marks elements as seen (.in) for the fallback reveal and the Running
      // moments, and counts PB times up once. Reduced motion: everything shows in place.
      (window as unknown as { __motion?: boolean }).__motion = 'IntersectionObserver' in window;
      if (!('IntersectionObserver' in window)) document.documentElement.classList.remove('js');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const countUp = (el: HTMLElement) => {
        const final = el.textContent ?? '';
        const parts = final.split(':').map(Number);
        if (reduce || parts.some(Number.isNaN)) return;
        const total = parts.reduce((a, n) => a * 60 + n, 0);
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min((now - start) / 1400, 1);
          let v = Math.round(total * (1 - Math.pow(1 - t, 4)));
          const out: string[] = [];
          for (let i = parts.length - 1; i >= 0; i--) {
            const n = i === 0 ? v : v % 60;
            out.unshift(i === 0 ? String(n) : String(n).padStart(2, '0'));
            v = Math.floor(v / 60);
          }
          el.textContent = t < 1 ? out.join(':') : final;
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.classList.add('in');
            if (el.dataset.count !== undefined) countUp(el);
            io.unobserve(el);
          }
        },
        { threshold: 0.25 },
      );
      document.querySelectorAll('.reveal, .pop, .grow-bar, [data-count]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
