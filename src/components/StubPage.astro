---
import { ArrowLeft } from '@lucide/astro';
import Base from '../layouts/Base.astro';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
}
const { eyebrow, title, text } = Astro.props;
---

<Base title={`${eyebrow} · Jeymarc Sison`}>
  <section class="mx-auto grid min-h-[80dvh] max-w-3xl content-center px-5 pt-14">
    <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-accent">{eyebrow}</p>
    <h1 class="mt-3 text-5xl font-semibold tracking-tight sm:text-7xl">{title}</h1>
    <p class="mt-6 text-xl text-muted">{text}</p>
    <a href="/" class="mt-10 inline-flex items-center gap-2 font-medium text-accent"><ArrowLeft size={18} stroke-width={1.8} aria-hidden="true" /> Back home</a>
  </section>
</Base>
