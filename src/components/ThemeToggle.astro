---
import { Sun, Moon } from '@lucide/astro';
---

<button
  type="button"
  data-theme-toggle
  hidden
  class="grid size-9 place-items-center rounded-full text-ink/80 transition hover:bg-card hover:text-ink"
  aria-label="Dark mode"
>
  <Sun size={18} stroke-width={1.6} class="theme-icon-sun" aria-hidden="true" />
  <Moon size={18} stroke-width={1.6} class="theme-icon-moon" aria-hidden="true" />
</button>

<style>
  .theme-icon-moon { display: none; }
  :global([data-theme='dark']) .theme-icon-sun { display: none; }
  :global([data-theme='dark']) .theme-icon-moon { display: block; }
</style>

<script>
  // Hidden without JavaScript (it couldn't do anything); shown and kept in sync here.
  const root = document.documentElement;
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () => button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
    button.hidden = false;
    sync();
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      sync();
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage blocked: the choice lasts for this page view only.
      }
    });
  }
</script>
