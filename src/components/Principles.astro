---
// "How I work": short principles, revealed one after another.
interface Props {
  items: readonly { title: string; text: string }[];
}
const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="mt-16">
      <h3 class="reveal text-xl font-semibold tracking-tight">How I work</h3>
      <ol class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 stagger">
        {items.map((p, i) => (
          <li class="reveal rounded-3xl border border-line p-7">
            <span class="text-sm font-semibold tabular-nums text-accent" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="mt-3 text-lg font-semibold tracking-tight">{p.title}</p>
            <p class="mt-2 text-muted">{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  )
}
