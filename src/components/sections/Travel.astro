---
import { MapPin } from '@lucide/astro';
import Section from '../Section.astro';
import { trips } from '../../data/sample';

// Placeholder until Phase 4: an abstract map panel. The real interactive MapLibre map (green styles for
// light and dark) arrives in Phase 4.
---

<Section
  id="travel"
  eyebrow="Travel"
  title="Places that stayed with me."
  lede="A pin for every trip, each with a handful of photos and the story behind them."
  deepDive={{ href: '/travel', label: 'Open the map' }}
  tone="card"
>
  <div class="reveal relative aspect-[16/9] overflow-hidden rounded-[2rem] border border-line bg-surface">
    <svg class="absolute inset-0 h-full w-full" aria-hidden="true">
      <defs>
        <pattern id="travel-dots" width="14" height="14" patternUnits="userSpaceOnUse">
          <circle cx="7" cy="7" r="1.6" fill="var(--c-line)" />
        </pattern>
        <radialGradient id="travel-fade" cx="50%" cy="50%" r="60%">
          <stop offset="0%" stop-color="var(--c-accent-soft)" />
          <stop offset="100%" stop-color="var(--c-surface)" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="100%" height="100%" fill="url(#travel-fade)" />
      <rect width="100%" height="100%" fill="url(#travel-dots)" />
    </svg>
    {
      trips.map((t) => (
        <span class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${t.x}%;top:${t.y}%`}>
          <span class="pulse relative block size-3 rounded-full bg-accent ring-4 ring-accent/20" />
          <span class="absolute left-4 top-1/2 hidden -translate-y-1/2 whitespace-nowrap rounded-full bg-surface/90 px-2.5 py-1 text-xs font-medium shadow-sm sm:block">{t.place}</span>
        </span>
      ))
    }
    <span class="absolute bottom-4 right-4 rounded-full bg-surface/80 px-3 py-1 text-[11px] text-muted backdrop-blur">Interactive map in the full version</span>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-3">
    {
      trips.slice(0, 3).map((t, i) => (
        <a href="/travel" class="reveal lift group overflow-hidden rounded-3xl bg-surface">
          <div
            class="aspect-[4/3] transition-transform duration-700 group-hover:scale-105"
            style={`background: linear-gradient(${160 + i * 50}deg, color-mix(in oklab, var(--c-accent) ${45 - i * 10}%, var(--c-card)), var(--c-accent-soft))`}
            aria-hidden="true"
          />
          <div class="p-6">
            <p class="flex items-center gap-1.5 text-sm text-muted"><MapPin size={14} stroke-width={1.8} aria-hidden="true" />{t.country} · {t.year}</p>
            <h3 class="mt-1 text-xl font-semibold tracking-tight">{t.place}</h3>
          </div>
        </a>
      ))
    }
  </div>
</Section>
