---
import Section from '../Section.astro';
import WorldMap from '../WorldMap.astro';
import { getPlaces } from '../../lib/content';
import { byCountry, counts } from '../../lib/places';
import { LAND_LOW } from '../../assets/map/land';

const places = await getPlaces();
const total = counts(places);
const groups = byCountry(places);
---

<Section
  id="travel"
  eyebrow="Travel"
  title="Places that stayed with me."
  lede={`${total.cities} cities in ${total.countries} countries so far, and counting.`}
  deepDive={{ href: '/travel', label: 'Explore the map' }}
  tone="card"
>
  <div class="reveal overflow-hidden rounded-[2rem] border border-line bg-surface p-3 sm:p-6">
    <WorldMap places={places} land={LAND_LOW} id="home-map" />
  </div>

  <dl class="mt-10 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      groups.map((g) => (
        <div class="reveal">
          <dt class="text-sm font-semibold">{g.country}</dt>
          <dd class="mt-1 text-muted">{g.cities.map((c) => c.city).join(' · ')}</dd>
        </div>
      ))
    }
  </dl>
</Section>
