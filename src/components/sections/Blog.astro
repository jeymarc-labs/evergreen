---
import Section from '../Section.astro';
import PostCard from '../PostCard.astro';
import { getPosts } from '../../lib/content';

// Latest three: the newest is featured, the next two sit beside it.
const [featured, ...rest] = (await getPosts()).slice(0, 3);
---

<Section
  id="blog"
  eyebrow="Blog"
  title="Notes from the journey."
  lede="What I'm working on, what I'm learning, and a running series on learning AI in public."
  deepDive={{ href: '/blog', label: 'Read the blog' }}
  tone="card"
>
  {
    featured ? (
      <div class:list={['grid gap-6', rest.length > 0 && 'lg:grid-cols-[1.3fr_1fr]']}>
        <PostCard post={featured} featured />
        {rest.length > 0 && (
          <div class="grid content-start gap-6">
            {rest.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        )}
      </div>
    ) : (
      <p class="reveal text-lg text-muted">The first posts are on their way.</p>
    )
  }
</Section>
