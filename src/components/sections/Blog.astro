---
import { Sparkles } from '@lucide/astro';
import Section from '../Section.astro';
import { posts } from '../../data/sample';

const [featured, ...rest] = posts;
---

<Section
  id="blog"
  eyebrow="Blog"
  title="Notes from the journey."
  lede="What I'm working on, what I'm learning, and a running series on learning AI in public."
  deepDive={{ href: '/blog', label: 'Read the blog' }}
  tone="card"
>
  <div class="grid gap-6 lg:grid-cols-[1.3fr_1fr]">
    <a href="/blog" class="reveal lift group relative overflow-hidden rounded-[2rem] bg-surface p-10">
      <div class="absolute -right-16 -top-16 size-64 rounded-full bg-[radial-gradient(closest-side,var(--c-glow),transparent)]"></div>
      <p class="flex items-center gap-2 text-sm font-semibold text-accent">
        <Sparkles size={16} stroke-width={1.8} aria-hidden="true" /> {featured.series} · {featured.part}
      </p>
      <h3 class="mt-6 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{featured.title}</h3>
      <p class="mt-10 text-sm text-muted">{featured.date}</p>
    </a>
    <div class="grid gap-6">
      {
        rest.map((p) => (
          <a href="/blog" class="reveal lift rounded-[2rem] bg-surface p-8">
            <h3 class="text-xl font-semibold leading-snug tracking-tight">{p.title}</h3>
            <p class="mt-4 text-sm text-muted">{p.date}</p>
          </a>
        ))
      }
    </div>
  </div>
</Section>
