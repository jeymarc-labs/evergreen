---
import { Image } from 'astro:assets';
import { Medal, Timer, Star } from '@lucide/astro';
import Section from '../Section.astro';
import { getRunning } from '../../lib/content';
import { formatDate } from '../../lib/blog';
import { latestRace as findLatest, majorsProgress, personalBests } from '../../lib/running';

const { races, majors, instagram } = await getRunning();
const runningStats = personalBests(races);
const latestRace = findLatest(races);

const progress = majorsProgress(majors);
const statusLabel = { done: 'Done', planned: 'Planned', open: 'Someday' } as const;
---

<Section
  id="running"
  eyebrow="Running · jeymarc.logs"
  title="Every run tells a story."
  lede="Training logs, race reports and the long road to all eight World Marathon Majors."
  deepDive={{ href: '/running', label: 'Into the logs' }}
>
  <!-- Stats -->
  <div class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4 stagger">
    {
      runningStats.map((s) => (
        <div class="pop">
          {s.value ? (
            <p class="text-4xl font-semibold tabular-nums tracking-tight text-accent sm:text-5xl lg:text-6xl">
              <span data-count aria-hidden="true">{s.value}</span><span class="sr-only">{s.value}</span>
            </p>
          ) : (
            <p class="text-4xl font-semibold tracking-tight text-muted/50 sm:text-5xl lg:text-6xl" aria-label="Coming soon">––:––</p>
          )}
          <p class="mt-2 text-muted">{s.label}</p>
        </div>
      ))
    }
  </div>

  <!-- Majors -->
  <div class="mt-28">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <h3 class="text-3xl font-semibold tracking-tight sm:text-4xl">World Marathon Majors</h3>
      <p class="text-muted"><span class="font-semibold text-ink">{progress.done}</span> of {progress.total} done</p>
    </div>
    <div class="reveal mt-6 h-1.5 overflow-hidden rounded-full bg-line">
      <div class="grow-bar h-full rounded-full bg-accent" style={`width: ${progress.percent}%`}></div>
    </div>
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4 stagger">
      {
        majors.map((m) => {
          return (
            <li
              class:list={[
                'reveal lift relative flex flex-col items-center rounded-3xl border p-5 text-center',
                m.status === 'done' ? 'border-accent/40 bg-accent-soft' : 'border-line bg-card',
              ]}
            >
              <span
                class:list={['absolute right-4 top-3 text-xl leading-none', m.status === 'open' && 'opacity-50 grayscale']}
                aria-hidden="true"
              >{m.flag}</span>
              <Star
                size={30}
                stroke-width={1.4}
                fill={m.status === 'done' ? 'currentColor' : 'none'}
                stroke-dasharray={m.status === 'planned' ? '3 3' : undefined}
                class:list={[m.status === 'open' ? 'text-muted' : 'text-accent', m.status === 'done' && 'star-land']}
                aria-hidden="true"
              />
              <p class="mt-4 font-semibold">{m.city}</p>
              <p class="mt-1 text-xs text-muted">{statusLabel[m.status]}{m.when && ` · ${m.when}`}</p>
            </li>
          );
        })
      }
    </ul>
  </div>

  <!-- Latest race -->
  {latestRace && (
  <div class="mt-28">
    <article class="reveal flex flex-col justify-between gap-12 rounded-3xl bg-accent p-8 text-accent-ink sm:p-12 lg:flex-row lg:items-end">
      <div>
        <p class="flex items-center gap-2 text-sm font-medium"><Medal size={18} stroke-width={1.6} aria-hidden="true" /> Latest race</p>
        <h3 class="mt-4 text-3xl font-semibold tracking-tight">{latestRace.name}</h3>
        <p class="mt-1">{formatDate(new Date(latestRace.date))}</p>
      </div>
      <div class="lg:text-right">
        <p class="flex items-center gap-2 text-6xl lg:justify-end font-semibold tracking-tight"><Timer size={36} stroke-width={1.4} aria-hidden="true" />{latestRace.time}</p>
        {latestRace.note && <p class="mt-3">{latestRace.note}</p>}
        <a href="/running" class="mt-6 inline-block font-medium underline underline-offset-4">Read the race report</a>
      </div>
    </article>
  </div>
  )}

  <!-- Instagram: posts Jeymarc picks in the admin (his own photo copies; nothing loads from Instagram) -->
  <div class="mt-28">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <h3 class="text-3xl font-semibold tracking-tight sm:text-4xl">From @jeymarc.logs</h3>
      <a href="https://www.instagram.com/jeymarc.logs/" class="font-medium text-accent">Follow on Instagram</a>
    </div>
    {
      instagram.length > 0 && (
        <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4 stagger">
          {instagram.map((post) => (
            <li class="reveal">
              <a href={post.url} class="lift block overflow-hidden rounded-2xl" aria-label={`${post.alt} (opens on Instagram)`}>
                <Image src={post.image} alt={post.alt} widths={[240, 400, 640]} sizes="(min-width: 640px) 25vw, 50vw" class="aspect-square w-full object-cover" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Section>
