---
import { ArrowUpRight, Briefcase, Layers, Users } from '@lucide/astro';
import Section from '../Section.astro';
import { getPlaces, getProfile, getRunning } from '../../lib/content';
import { marathonCount } from '../../lib/running';
import { quickFacts } from '../../lib/about';
import Languages from '../Languages.astro';
import QuickFacts from '../QuickFacts.astro';
import Principles from '../Principles.astro';
import BeyondWork from '../BeyondWork.astro';

const profile = await getProfile();
const places = await getPlaces();
const facts = quickFacts({
  yearsInFinance: profile.yearsInFinance,
  marathons: marathonCount((await getRunning()).races),
  cities: places.length,
  languages: profile.languages.length,
});
const linkedin = profile.links.find((l) => /linkedin\.com/i.test(l.url));

const roles = [
  { icon: Briefcase, title: 'Finance', text: 'My whole career, at two global banks.' },
  { icon: Users, title: 'Consultant', text: 'Helping teams find the problem worth solving.' },
  { icon: Layers, title: 'Product manager', text: 'Turning that into something people use.' },
];
---

<Section id="about" eyebrow="About" title="Numbers, products and people." lede={profile.about}>
  <div class="grid gap-5 sm:grid-cols-3 stagger">
    {
      roles.map(({ icon: Icon, title, text }) => (
        <div class="reveal lift rounded-3xl border border-line bg-card p-7">
          <Icon size={30} stroke-width={1.4} class="text-accent" aria-hidden="true" />
          <h3 class="mt-6 text-xl font-semibold tracking-tight">{title}</h3>
          <p class="mt-2 text-muted">{text}</p>
        </div>
      ))
    }
  </div>
  <QuickFacts facts={facts} />
  <Principles items={profile.principles} />
  {profile.languages.length > 0 && <Languages rows={profile.languages} />}
  <BeyondWork items={profile.beyond} />
  {
    linkedin && (
      <a href={linkedin.url} class="reveal mt-10 inline-flex items-center gap-2 font-medium text-accent">
        More on LinkedIn <ArrowUpRight size={18} stroke-width={1.8} aria-hidden="true" />
      </a>
    )
  }
</Section>
