---
import { ArrowLeft } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import TravelMap from '../components/TravelMap.astro';
import { getPlaces } from '../lib/content';
import { byCountry, counts } from '../lib/places';

const places = await getPlaces();
const total = counts(places);
const groups = byCountry(places);
---

<Base title="Travel · Jeymarc Sison" description={`${total.cities} cities in ${total.countries} countries on a map.`}>
  <section class="mx-auto max-w-6xl px-5 pb-28 pt-28 sm:pt-36">
    <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-accent">Travel</p>
    <h1 class="mt-3 text-5xl font-semibold tracking-tight sm:text-7xl">
      {total.cities} cities.<br /><span class="text-muted">{total.countries} countries.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-xl text-muted">Pick a region or tap a pin to fly there. Drag to look around; pinch to zoom.</p>

    <div class="mt-12">
      <TravelMap places={places} />
    </div>

    <h2 class="mt-24 text-3xl font-semibold tracking-tight">Every place</h2>
    <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        groups.map((g) => (
          <div>
            <dt class="text-sm font-semibold">{g.country}</dt>
            <dd class="mt-1 text-muted">{g.cities.map((c) => c.city).join(' · ')}</dd>
          </div>
        ))
      }
    </dl>

    <a href="/" class="mt-16 inline-flex items-center gap-2 font-medium text-accent"><ArrowLeft size={18} stroke-width={1.8} aria-hidden="true" /> Back home</a>
  </section>
</Base>
