---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/content';
import { SERIES, seriesPosts } from '../../lib/blog';

const posts = await getPosts();
const learning = seriesPosts(posts, 'learning-ai');
---

<Base title="Blog · Jeymarc Sison" description="Posts on what I'm working on, my interests, and learning AI in public.">
  <section class="mx-auto max-w-5xl px-5 pb-16 pt-36">
    <p class="text-[13px] font-semibold uppercase tracking-[0.16em] text-accent">Blog</p>
    <h1 class="mt-3 text-5xl font-semibold leading-[1.05] tracking-tight sm:text-7xl">Notes from the journey.</h1>
    <p class="mt-6 max-w-2xl text-xl text-muted">What I'm working on, what I'm learning, and a running series on learning AI in public.</p>
    <a href="/rss.xml" class="mt-6 inline-block text-sm font-medium text-accent">Subscribe via RSS</a>
  </section>

  {
    learning.length > 0 && (
      <section class="bg-card py-20" aria-labelledby="series-title">
        <div class="mx-auto max-w-5xl px-5">
          <h2 id="series-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">{SERIES['learning-ai'].title}</h2>
          <p class="mt-3 max-w-xl text-lg text-muted">{SERIES['learning-ai'].blurb}</p>
          <ol class="mt-10 grid gap-5 sm:grid-cols-2">
            {learning.map((post, i) => (
              <li>
                <PostCard post={post} featured={i === 0 && learning.length === 1} />
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-5xl px-5 py-20" aria-labelledby="all-title">
    <h2 id="all-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">All posts</h2>
    {
      posts.length === 0 ? (
        <p class="mt-6 text-lg text-muted">No posts yet. Soon.</p>
      ) : (
        <ul class="mt-10 grid gap-5">
          {posts.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
